# ==============================================================================
# Environment Variables for Dhu Raydan Hall Platform (قاعة ذو ريدان للأفراح)
# Vercel Production & Local Development Configuration
# ==============================================================================

# Application URL (On Vercel, this is automatically https://your-domain.vercel.app)
APP_URL="https://your-domain.vercel.app"

# Production API URL (Optional):
# - Leave empty if frontend & API are deployed on the same Vercel project (recommended, uses relative /api)
# - Set to your custom backend domain if hosting the backend separately (e.g. https://api.yourdomain.com)
# NOTE: In production, NEVER set this to localhost or 127.0.0.1!
VITE_API_URL=""

# Production PostgreSQL Database Connection URL (Supported: Neon, Supabase, Vercel Postgres, AWS RDS, Cloud SQL, Railway)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://username:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Initial Administrator Credentials (configured on server boot & seed)
ADMIN_EMAIL="admin@dhuraydan.com"
ADMIN_PASSWORD="admin123456"

# Session Secret (Optional: for JWT or session signing)
AUTH_SECRET="your-ultra-secure-jwt-auth-secret-key-32-chars-min"

# Google Maps Embed / Location URL
NEXT_PUBLIC_MAPS_URL="https://maps.google.com/?q=15.3789,44.2014"
