// Prisma Schema for Dhu Raydan Wedding and Event Hall (قاعة ذو ريدان للأفراح والمناسبات)
// Target Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum EventType {
  WEDDING
  GRADUATION
  CONFERENCE
  FAMILY
  CONDOLENCE
  PARTY
  OTHER
}

enum TimeSlot {
  MORNING
  EVENING
  FULL_DAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum HallSection {
  MEN
  WOMEN
  BOTH
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  phone         String
  passwordHash  String
  role          Role           @default(CUSTOMER)
  avatarUrl     String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  bookings      Booking[]
  reviews       Review[]
  notifications Notification[]

  @@map("users")
}

model Booking {
  id              String         @id @default(cuid())
  bookingCode     String         @unique // e.g. RDN-2026-101
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerName    String
  customerEmail   String
  customerPhone   String
  eventType       EventType
  eventDate       DateTime       @db.Date
  timeSlot        TimeSlot
  hallSection     HallSection    @default(BOTH)
  guestCount      Int
  packageId       String?
  package         Package?       @relation(fields: [packageId], references: [id])
  packageName     String?
  packagePrice    Decimal        @db.Decimal(12, 2)
  totalPrice      Decimal        @db.Decimal(12, 2)
  status          BookingStatus  @default(PENDING)
  notes           String?        @db.Text
  adminNotes      String?        @db.Text
  rejectionReason String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  bookingItems    BookingItem[]
  reviews         Review[]

  @@index([eventDate, timeSlot, status])
  @@index([userId])
  @@map("bookings")
}

model Service {
  id             String         @id @default(cuid())
  name           String
  description    String         @db.Text
  price          Decimal        @db.Decimal(10, 2)
  priceUsd       Decimal?       @db.Decimal(10, 2)
  category       String
  imageUrl       String
  isAvailable    Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  packageServices PackageService[]
  bookingItems    BookingItem[]

  @@map("services")
}

model Package {
  id                 String           @id @default(cuid())
  name               String
  slug               String           @unique
  description        String           @db.Text
  price              Decimal          @db.Decimal(12, 2)
  priceUsd           Decimal          @db.Decimal(10, 2)
  badge              String?
  features           String[]
  imageUrl           String
  isPopular          Boolean          @default(false)
  isActive           Boolean          @default(true)
  guestCapacityText  String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  packageServices    PackageService[]
  bookings           Booking[]

  @@map("packages")
}

model PackageService {
  id         String   @id @default(cuid())
  packageId  String
  package    Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
  @@map("package_services")
}

model BookingItem {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  serviceName String
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(1)

  @@map("booking_items")
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  imageUrl    String
  videoUrl    String?
  category    String
  mediaType   String   @default("image") // "image" or "video"
  sortOrder   Int      @default(0)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("gallery_items")
}

model Review {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  authorName  String
  authorPhone String?
  rating      Int      @default(5)
  comment     String   @db.Text
  source      String   @default("verified_customer") // "google" or "verified_customer"
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("reviews")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   // 'all_admin' or specific user id
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  type      String
  bookingId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model Settings {
  id                 String   @id @default("default")
  hallName           String
  tagline            String
  description        String   @db.Text
  phonePrimary       String
  phoneSecondary     String
  whatsappNumber     String
  email              String
  city               String
  address            String
  landmark           String
  plusCode           String
  googleMapsUrl      String
  workingHours       String
  ratingScore        Decimal  @default(4.4) @db.Decimal(2, 1)
  ratingCount        Int      @default(1182)
  capacityMax        Int      @default(1500)
  currency           String   @default("ريال يمني")
  usdExchangeRate    Decimal  @default(535) @db.Decimal(6, 2)
  facebookUrl        String?
  instagramUrl       String?
  tiktokUrl          String?
  heroHeadline       String
  heroSubheadline    String   @db.Text
  heroImageUrl       String
  heroNotice         String?
  cancellationPolicy String   @db.Text
  updatedAt          DateTime @updatedAt

  @@map("settings")
}
